{
  "name": "caissepro",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "pnpm --filter @caissepro/shared build && concurrently -k -n api,desktop \"pnpm --filter @caissepro/api dev\" \"pnpm --filter @caissepro/desktop tauri dev\"",
    "dev:api": "pnpm --filter @caissepro/shared build && pnpm --filter @caissepro/api dev",
    "dev:web": "pnpm --filter @caissepro/shared build && pnpm --filter @caissepro/desktop dev",
    "dev:desktop": "pnpm --filter @caissepro/shared build && pnpm --filter @caissepro/desktop tauri dev",
    "build": "pnpm --filter @caissepro/shared build && pnpm --filter @caissepro/api build && pnpm --filter @caissepro/desktop build",
    "build:desktop": "pnpm --filter @caissepro/shared build && pnpm --filter @caissepro/desktop tauri build",
    "typecheck": "pnpm --filter @caissepro/shared build && pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @caissepro/shared build && node --test tests/native/permissions.test.mjs tests/native/demo-macos.test.mjs tests/native/demo-password.test.mjs tests/native/demo-stop.test.mjs && pnpm -r --workspace-concurrency=1 test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:env": "node scripts/setup-env.mjs",
    "backup": "node scripts/backup.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @caissepro/api db:generate",
    "db:validate": "pnpm --filter @caissepro/api db:validate",
    "db:deploy": "pnpm --filter @caissepro/api db:deploy",
    "test:db": "node scripts/test-db.mjs",
    "test:local": "node scripts/check-local-store.mjs",
    "check:rust": "node scripts/check-rust.mjs",
    "test:e2e": "playwright test",
    "test:api:live": "node --test --test-concurrency=1 tests/smoke/api.test.mjs",
    "test:native:linux": "bash tests/native/smoke-linux.sh",
    "setup:admin": "pnpm --filter @caissepro/shared build && pnpm --filter @caissepro/api build && node scripts/bootstrap-admin.mjs",
    "test:session": "node scripts/check-session.mjs",
    "test:auth:desktop": "pnpm --filter @caissepro/shared build && pnpm --filter @caissepro/api build && node scripts/test-auth-desktop.mjs",
    "demo:prepare": "pnpm build && node scripts/demo.mjs prepare",
    "demo:start": "node scripts/demo.mjs start",
    "demo:stop": "node scripts/demo-stop.mjs",
    "demo:password": "node scripts/demo-password.mjs",
    "demo:backup:test": "node scripts/demo.mjs backup-test",
    "demo:native": "bash scripts/demo-native.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "typescript": "5.9.3",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "concurrently": "9.2.5",
    "@playwright/test": "1.58.2"
  }
}
