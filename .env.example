# Développement local uniquement. pnpm setup:env génère un mot de passe sans l'afficher.
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_LOCAL_ALEATOIRE
DATABASE_URL=postgresql://caissepro:REMPLACER_PAR_UN_MOT_DE_PASSE_LOCAL_ALEATOIRE@127.0.0.1:5432/caissepro?schema=public
API_DEPLOYMENT_ID=caissepro-development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Variables publiques embarquées : aucun secret ne doit porter le préfixe VITE_.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_API_DEPLOYMENT_ID=caissepro-development
