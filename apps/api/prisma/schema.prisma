generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  TREASURY
  CLEARING
  EQUITY
}

enum SessionState {
  OPEN
  CLOSED
}

enum OperationKind {
  RECEIPT
  DISBURSEMENT
  TRANSFER
  FX
  REVERSAL
}

enum EntrySide {
  DEBIT
  CREDIT
}

enum ExpenseState {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum ApprovalDecision {
  APPROVE
  REJECT
}

enum ReservationState {
  ACTIVE
  CONSUMED
  RELEASED
}

enum DraftKind {
  RECEIPT
  EXPENSE_REQUEST
}

model Installation {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Company {
  address          String                   @default("") @db.VarChar(300)
  phone            String                   @default("") @db.VarChar(60)
  email            String                   @default("") @db.VarChar(254)
  taxId            String                   @default("") @db.VarChar(100)
  settingsVersion  Int                      @default(1)
  sessionMinutes   Int                      @default(480)
  idleMinutes      Int                      @default(15)
  offlineMinutes   Int                      @default(15)
  syncEvents       SyncEvent[]
  code             String                   @unique @default(dbgenerated("('CP-'::text || upper(substr((gen_random_uuid())::text, 1, 12)))")) @db.VarChar(32)
  id               String                   @id @default(uuid()) @db.Uuid
  name             String                   @db.VarChar(160)
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  agencies         Agency[]
  members          CompanyMember[]
  roles            Role[]
  rates            ExchangeRate[]
  audits           AuditEvent[]
  receiptCounters  ReceiptCounter[]
  expensePolicies  ExpensePolicy[]
  voucherCounters  VoucherCounter[]
  currencies       CompanyCurrency[]
  monetarySettings CompanyMonetarySettings?
}

model Agency {
  version    Int                  @default(1)
  id         String               @id @default(uuid()) @db.Uuid
  companyId  String               @db.Uuid
  code       String               @db.VarChar(40)
  name       String               @db.VarChar(160)
  active     Boolean              @default(true)
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  grants     AgencyGrant[]
  registers  CashRegister[]
  accounts   TreasuryAccount[]
  operations FinancialOperation[]
  drafts     ImportedDraft[]

  @@unique([companyId, id])
  @@unique([companyId, code])
}

model User {
  syncEvents         SyncEvent[]
  securityVersion    Int                  @default(1)
  mustChangePassword Boolean              @default(false)
  credential         UserCredential?
  authSessions       AuthSession[]
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(254)
  displayName        String               @db.VarChar(160)
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  members            CompanyMember[]
  openedSessions     CashSession[]        @relation("SessionOpener")
  closedSessions     CashSession[]        @relation("SessionCloser")
  operations         FinancialOperation[]
  expenses           ExpenseRequest[]
  approvals          ExpenseApproval[]
  attachments        Attachment[]
  audits             AuditEvent[]
  drafts             ImportedDraft[]
  cashReceipts       CashReceipt[]
  paymentVouchers    PaymentVoucher[]
}

model CompanyMember {
  authorizationVersion Int                  @default(1)
  cashGrants           CashRegisterGrant[]
  authSessions         AuthSession[]
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @db.Uuid
  userId               String               @db.Uuid
  active               Boolean              @default(true)
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles                MemberRole[]
  agencies             AgencyGrant[]
  moneyPreferences     UserMoneyPreference?

  @@unique([companyId, id])
  @@unique([companyId, userId])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  code        String           @db.VarChar(60)
  active      Boolean          @default(true)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members     MemberRole[]
  permissions RolePermission[]

  @@unique([companyId, id])
  @@unique([companyId, code])
}

model Permission {
  code        String           @id @db.VarChar(80)
  description String           @db.VarChar(200)
  roles       RolePermission[]
}

model MemberRole {
  companyId String        @db.Uuid
  memberId  String        @db.Uuid
  roleId    String        @db.Uuid
  member    CompanyMember @relation(fields: [companyId, memberId], references: [companyId, id], onDelete: Restrict)
  role      Role          @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, memberId, roleId])
}

model RolePermission {
  companyId      String     @db.Uuid
  roleId         String     @db.Uuid
  permissionCode String     @db.VarChar(80)
  role           Role       @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([companyId, roleId, permissionCode])
}

model AgencyGrant {
  companyId String        @db.Uuid
  memberId  String        @db.Uuid
  agencyId  String        @db.Uuid
  member    CompanyMember @relation(fields: [companyId, memberId], references: [companyId, id], onDelete: Restrict)
  agency    Agency        @relation(fields: [companyId, agencyId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, memberId, agencyId])
}

model CashRegister {
  version           Int                 @default(1)
  configurationHash String?             @db.Char(64)
  grants            CashRegisterGrant[]
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @db.Uuid
  agencyId          String              @db.Uuid
  code              String              @db.VarChar(40)
  name              String              @db.VarChar(160)
  active            Boolean             @default(true)
  agency            Agency              @relation(fields: [companyId, agencyId], references: [companyId, id], onDelete: Restrict)
  accounts          TreasuryAccount[]
  sessions          CashSession[]
  receipts          CashReceipt[]

  @@unique([companyId, id, agencyId])
  @@unique([companyId, id])
  @@unique([companyId, agencyId, code])
}

model TreasuryAccount {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  agencyId           String             @db.Uuid
  cashRegisterId     String?            @db.Uuid
  code               String             @db.VarChar(60)
  currency           String
  kind               AccountKind
  active             Boolean            @default(true)
  agency             Agency             @relation(fields: [companyId, agencyId], references: [companyId, id], onDelete: Restrict)
  register           CashRegister?      @relation(fields: [companyId, cashRegisterId, agencyId], references: [companyId, id, agencyId], onDelete: Restrict)
  entries            LedgerEntry[]
  expenses           ExpenseRequest[]
  reservations       FundReservation[]
  outgoing           Transfer[]         @relation("TransferSource")
  incoming           Transfer[]         @relation("TransferDestination")
  currencyDefinition CurrencyDefinition @relation("TreasuryAccount_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "TreasuryAccount_currency_catalog_fk")

  @@unique([companyId, id, currency])
  @@unique([companyId, id, currency, agencyId])
  @@unique([companyId, agencyId, code, currency])
  @@unique([companyId, cashRegisterId, currency])
}

model CashSession {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  agencyId       String        @db.Uuid
  cashRegisterId String        @db.Uuid
  openedById     String        @db.Uuid
  closedById     String?       @db.Uuid
  state          SessionState  @default(OPEN)
  openedAt       DateTime      @default(now()) @db.Timestamptz(3)
  closedAt       DateTime?     @db.Timestamptz(3)
  register       CashRegister  @relation(fields: [companyId, cashRegisterId, agencyId], references: [companyId, id, agencyId], onDelete: Restrict)
  opener         User          @relation("SessionOpener", fields: [openedById], references: [id], onDelete: Restrict)
  closer         User?         @relation("SessionCloser", fields: [closedById], references: [id], onDelete: Restrict)
  entries        LedgerEntry[]

  @@unique([companyId, id])
}

model FinancialOperation {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  agencyId           String              @db.Uuid
  createdById        String              @db.Uuid
  kind               OperationKind
  currency           String?
  idempotencyKey     String              @db.Uuid
  requestHash        String              @db.Char(64)
  postedAt           DateTime            @default(now()) @db.Timestamptz(3)
  transactionId      BigInt              @default(dbgenerated("txid_current()"))
  expenseRequestId   String?             @db.Uuid
  reversalOfId       String?             @db.Uuid
  reasonCode         String?             @db.VarChar(80)
  exchangeRateId     String?             @db.Uuid
  sourceAmount       Decimal?            @db.Decimal(24, 8)
  targetAmount       Decimal?            @db.Decimal(24, 8)
  agency             Agency              @relation(fields: [companyId, agencyId], references: [companyId, id], onDelete: Restrict)
  creator            User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  expense            ExpenseRequest?     @relation(fields: [companyId, expenseRequestId], references: [companyId, id], onDelete: Restrict)
  original           FinancialOperation? @relation("OperationReversal", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  reversal           FinancialOperation? @relation("OperationReversal")
  rate               ExchangeRate?       @relation(fields: [companyId, exchangeRateId], references: [companyId, id], onDelete: Restrict)
  entries            LedgerEntry[]
  transfer           Transfer?
  attachments        Attachment[]
  cashReceipt        CashReceipt?
  paymentVoucher     PaymentVoucher?
  currencyDefinition CurrencyDefinition? @relation("FinancialOperation_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "FinancialOperation_currency_catalog_fk")

  @@unique([companyId, id])
  @@unique([companyId, idempotencyKey])
  @@unique([companyId, expenseRequestId])
  @@unique([companyId, reversalOfId])
  @@index([companyId, postedAt])
}

model LedgerEntry {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  operationId        String             @db.Uuid
  accountId          String             @db.Uuid
  cashSessionId      String?            @db.Uuid
  lineNo             Int
  currency           String
  side               EntrySide
  amount             Decimal            @db.Decimal(24, 8)
  operation          FinancialOperation @relation(fields: [companyId, operationId], references: [companyId, id], onDelete: Restrict)
  account            TreasuryAccount    @relation(fields: [companyId, accountId, currency], references: [companyId, id, currency], onDelete: Restrict)
  session            CashSession?       @relation(fields: [companyId, cashSessionId], references: [companyId, id], onDelete: Restrict)
  currencyDefinition CurrencyDefinition @relation("LedgerEntry_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "LedgerEntry_currency_catalog_fk")

  @@unique([companyId, operationId, lineNo])
  @@index([companyId, accountId])
}

model ExpenseRequest {
  category            String               @default("Dépenses non catégorisées") @db.VarChar(80)
  workflowTransaction BigInt?
  sourceDraftId       String?              @db.Uuid
  sourceVersion       Int?
  beneficiary         String?              @db.VarChar(160)
  reference           String?              @db.VarChar(160)
  source              ImportedDraft?       @relation(fields: [companyId, sourceDraftId], references: [companyId, id], onDelete: Restrict)
  evidence            ExpenseEvidence[]
  voucher             PaymentVoucher?
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  agencyId            String               @db.Uuid
  accountId           String               @db.Uuid
  requestedById       String               @db.Uuid
  currency            String
  amount              Decimal              @db.Decimal(24, 8)
  description         String               @db.VarChar(500)
  state               ExpenseState         @default(PENDING)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  account             TreasuryAccount      @relation(fields: [companyId, accountId, currency, agencyId], references: [companyId, id, currency, agencyId], onDelete: Restrict)
  requester           User                 @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  approval            ExpenseApproval?
  reservation         FundReservation?
  operations          FinancialOperation[]
  attachments         Attachment[]
  currencyDefinition  CurrencyDefinition   @relation("ExpenseRequest_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "ExpenseRequest_currency_catalog_fk")

  @@unique([companyId, id])
  @@unique([companyId, sourceDraftId])
  @@index([companyId, agencyId, state])
}

model ExpenseApproval {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  expenseRequestId   String             @db.Uuid
  approverId         String             @db.Uuid
  reason             String?            @db.VarChar(500)
  decision           ApprovalDecision
  currency           String
  amount             Decimal            @db.Decimal(24, 8)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  expense            ExpenseRequest     @relation(fields: [companyId, expenseRequestId], references: [companyId, id], onDelete: Restrict)
  approver           User               @relation(fields: [approverId], references: [id], onDelete: Restrict)
  currencyDefinition CurrencyDefinition @relation("ExpenseApproval_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "ExpenseApproval_currency_catalog_fk")

  @@unique([companyId, expenseRequestId])
}

model FundReservation {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  expenseRequestId   String             @db.Uuid
  accountId          String             @db.Uuid
  currency           String
  amount             Decimal            @db.Decimal(24, 8)
  state              ReservationState   @default(ACTIVE)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  expense            ExpenseRequest     @relation(fields: [companyId, expenseRequestId], references: [companyId, id], onDelete: Restrict)
  account            TreasuryAccount    @relation(fields: [companyId, accountId, currency], references: [companyId, id, currency], onDelete: Restrict)
  currencyDefinition CurrencyDefinition @relation("FundReservation_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "FundReservation_currency_catalog_fk")

  @@unique([companyId, expenseRequestId])
  @@index([companyId, accountId, state])
}

model Transfer {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @db.Uuid
  operationId          String             @db.Uuid
  sourceAccountId      String             @db.Uuid
  destinationAccountId String             @db.Uuid
  currency             String
  amount               Decimal            @db.Decimal(24, 8)
  operation            FinancialOperation @relation(fields: [companyId, operationId], references: [companyId, id], onDelete: Restrict)
  source               TreasuryAccount    @relation("TransferSource", fields: [companyId, sourceAccountId, currency], references: [companyId, id, currency], onDelete: Restrict)
  destination          TreasuryAccount    @relation("TransferDestination", fields: [companyId, destinationAccountId, currency], references: [companyId, id, currency], onDelete: Restrict)
  currencyDefinition   CurrencyDefinition @relation("Transfer_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "Transfer_currency_catalog_fk")

  @@unique([companyId, operationId])
}

model ExchangeRate {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @db.Uuid
  fromCurrency           String
  toCurrency             String
  rate                   Decimal              @db.Decimal(24, 12)
  effectiveAt            DateTime             @db.Timestamptz(3)
  source                 String               @db.VarChar(100)
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operations             FinancialOperation[]
  fromCurrencyDefinition CurrencyDefinition   @relation("ExchangeRate_fromCurrency_catalog", fields: [fromCurrency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "ExchangeRate_fromCurrency_catalog_fk")
  toCurrencyDefinition   CurrencyDefinition   @relation("ExchangeRate_toCurrency_catalog", fields: [toCurrency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "ExchangeRate_toCurrency_catalog_fk")

  @@unique([companyId, id])
  @@index([companyId, fromCurrency, toCurrency, effectiveAt])
}

model Attachment {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @db.Uuid
  operationId      String?             @db.Uuid
  expenseRequestId String?             @db.Uuid
  uploadedById     String              @db.Uuid
  objectKey        String              @unique @db.VarChar(200)
  sha256           String              @db.Char(64)
  mimeType         String              @db.VarChar(100)
  byteLength       Int
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  operation        FinancialOperation? @relation(fields: [companyId, operationId], references: [companyId, id], onDelete: Restrict)
  expense          ExpenseRequest?     @relation(fields: [companyId, expenseRequestId], references: [companyId, id], onDelete: Restrict)
  uploader         User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  actorId    String   @db.Uuid
  action     String   @db.VarChar(60)
  targetType String   @db.VarChar(60)
  targetId   String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, targetType, targetId])
}

model ImportedDraft {
  syncEvents         SyncEvent[]
  clientCreatedAt    DateTime?          @db.Timestamptz(3)
  clientUpdatedAt    DateTime?          @db.Timestamptz(3)
  expenseDetails     Json?
  expense            ExpenseRequest?
  receiptProvenance  String?            @db.VarChar(160)
  receiptCategory    String?            @db.VarChar(80)
  receiptReference   String?            @db.VarChar(160)
  evidenceName       String?            @db.VarChar(160)
  evidenceMime       String?            @db.VarChar(100)
  evidenceSha        String?            @db.Char(64)
  evidenceBytes      Bytes?
  receipt            CashReceipt?
  cashRegisterId     String?            @db.Uuid
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  agencyId           String             @db.Uuid
  authorId           String             @db.Uuid
  clientDraftId      String             @db.Uuid
  kind               DraftKind
  currency           String
  amount             Decimal            @db.Decimal(24, 8)
  description        String             @db.VarChar(500)
  version            Int
  payloadHash        String             @db.Char(64)
  receivedAt         DateTime           @default(now()) @db.Timestamptz(3)
  agency             Agency             @relation(fields: [companyId, agencyId], references: [companyId, id], onDelete: Restrict)
  author             User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  currencyDefinition CurrencyDefinition @relation("ImportedDraft_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "ImportedDraft_currency_catalog_fk")

  @@unique([companyId, authorId, clientDraftId])
  @@unique([companyId, id])
}

model ReceiptCounter {
  companyId    String  @db.Uuid
  year         Int
  lastSequence BigInt
  company      Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, year])
}

model CashReceipt {
  evidenceByteLength Int?
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  agencyId           String             @db.Uuid
  cashRegisterId     String             @db.Uuid
  sourceDraftId      String             @db.Uuid
  sourceVersion      Int
  clientDraftId      String             @db.Uuid
  operationId        String             @db.Uuid
  createdById        String             @db.Uuid
  currency           String
  amount             Decimal            @db.Decimal(24, 8)
  provenance         String             @db.VarChar(160)
  category           String             @db.VarChar(80)
  description        String             @db.VarChar(500)
  reference          String             @db.VarChar(160)
  companyName        String             @db.VarChar(160)
  companyCode        String             @db.VarChar(32)
  agencyName         String             @db.VarChar(160)
  agencyCode         String             @db.VarChar(40)
  cashName           String             @db.VarChar(160)
  cashCode           String             @db.VarChar(40)
  cashierName        String             @db.VarChar(160)
  postedAt           DateTime           @db.Timestamptz(3)
  year               Int
  sequence           BigInt
  number             String             @db.VarChar(160)
  evidenceName       String?            @db.VarChar(160)
  evidenceMime       String?            @db.VarChar(100)
  evidenceSha        String?            @db.Char(64)
  evidenceBytes      Bytes?
  register           CashRegister       @relation(fields: [companyId, cashRegisterId, agencyId], references: [companyId, id, agencyId], onDelete: Restrict)
  operation          FinancialOperation @relation(fields: [companyId, operationId], references: [companyId, id], onDelete: Restrict)
  source             ImportedDraft      @relation(fields: [companyId, sourceDraftId], references: [companyId, id], onDelete: Restrict)
  creator            User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  currencyDefinition CurrencyDefinition @relation("CashReceipt_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "CashReceipt_currency_catalog_fk")

  @@unique([companyId, id])
  @@unique([companyId, sourceDraftId])
  @@unique([companyId, operationId])
  @@unique([companyId, number])
  @@unique([companyId, year, sequence])
  @@index([companyId, cashRegisterId, postedAt, id])
}

model UserCredential {
  userId       String   @id @db.Uuid
  passwordHash String   @db.VarChar(256)
  changedAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model CashRegisterGrant {
  companyId      String        @db.Uuid
  memberId       String        @db.Uuid
  agencyId       String        @db.Uuid
  cashRegisterId String        @db.Uuid
  member         CompanyMember @relation(fields: [companyId, memberId], references: [companyId, id], onDelete: Restrict)
  register       CashRegister  @relation(fields: [companyId, cashRegisterId, agencyId], references: [companyId, id, agencyId], onDelete: Restrict)

  @@id([companyId, memberId, cashRegisterId])
}

model AuthSession {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  memberId      String        @db.Uuid
  userId        String        @db.Uuid
  deviceId      String        @db.Uuid
  tokenHash     String        @unique @db.Char(64)
  userVersion   Int
  memberVersion Int
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime      @db.Timestamptz(3)
  idleExpiresAt DateTime      @db.Timestamptz(3)
  lockedAt      DateTime?     @db.Timestamptz(3)
  revokedAt     DateTime?     @db.Timestamptz(3)
  member        CompanyMember @relation(fields: [companyId, memberId], references: [companyId, id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([companyId, userId, revokedAt])
}

model AuthThrottle {
  key             String    @id @db.Char(64)
  windowStartedAt DateTime  @db.Timestamptz(3)
  failures        Int       @default(0)
  blockedUntil    DateTime? @db.Timestamptz(3)
}

model AuthEvent {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @db.Uuid
  actorId   String?  @db.Uuid
  subjectId String?  @db.Uuid
  sessionId String?  @db.Uuid
  deviceId  String?  @db.Uuid
  code      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([companyId, createdAt])
}

model ExpensePolicy {
  companyId          String             @db.Uuid
  currency           String
  version            Int
  requireEvidence    Boolean
  limits             Json
  payloadHash        String             @db.Char(64)
  configuredById     String             @db.Uuid
  configuredAt       DateTime           @db.Timestamptz(3)
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  currencyDefinition CurrencyDefinition @relation("ExpensePolicy_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "ExpensePolicy_currency_catalog_fk")

  @@id([companyId, currency])
}

model ExpenseEvidence {
  byteLength       Int
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @db.Uuid
  expenseRequestId String         @db.Uuid
  ordinal          Int
  fileName         String         @db.VarChar(160)
  mimeType         String         @db.VarChar(100)
  sha256           String         @db.Char(64)
  bytes            Bytes
  expense          ExpenseRequest @relation(fields: [companyId, expenseRequestId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, expenseRequestId, ordinal])
}

model VoucherCounter {
  companyId    String  @db.Uuid
  year         Int
  lastSequence BigInt
  company      Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, year])
}

model PaymentVoucher {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  expenseRequestId   String             @db.Uuid
  operationId        String             @db.Uuid
  createdById        String             @db.Uuid
  currency           String
  amount             Decimal            @db.Decimal(24, 8)
  beneficiary        String             @db.VarChar(160)
  description        String             @db.VarChar(500)
  reference          String             @db.VarChar(160)
  companyName        String             @db.VarChar(160)
  companyCode        String             @db.VarChar(32)
  agencyName         String             @db.VarChar(160)
  cashName           String             @db.VarChar(160)
  requesterName      String             @db.VarChar(160)
  approverName       String             @db.VarChar(160)
  cashierName        String             @db.VarChar(160)
  approvedAt         DateTime           @db.Timestamptz(3)
  postedAt           DateTime           @db.Timestamptz(3)
  year               Int
  sequence           BigInt
  number             String             @db.VarChar(160)
  expense            ExpenseRequest     @relation(fields: [companyId, expenseRequestId], references: [companyId, id], onDelete: Restrict)
  operation          FinancialOperation @relation(fields: [companyId, operationId], references: [companyId, id], onDelete: Restrict)
  creator            User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  currencyDefinition CurrencyDefinition @relation("PaymentVoucher_currency_catalog", fields: [currency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "PaymentVoucher_currency_catalog_fk")

  @@unique([companyId, id])
  @@unique([companyId, expenseRequestId])
  @@unique([companyId, operationId])
  @@unique([companyId, year, sequence])
  @@unique([companyId, number])
}

model SyncEvent {
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  source        ImportedDraft? @relation(fields: [companyId, serverId], references: [companyId, id], onDelete: Restrict)
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @db.Uuid
  authorId      String         @db.Uuid
  attemptId     String         @db.Uuid
  clientDraftId String         @db.Uuid
  version       Int
  stage         String         @db.VarChar(20)
  code          String         @db.VarChar(60)
  serverId      String?        @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([companyId, authorId, attemptId, stage])
  @@index([companyId, authorId, createdAt])
}

model TransferOrder {
  id                            String             @id @db.Uuid
  companyId                     String             @db.Uuid
  authorId                      String             @db.Uuid
  sourceCashRegisterId          String             @db.Uuid
  destinationCashRegisterId     String             @db.Uuid
  sourceAccountId               String             @db.Uuid
  destinationAccountId          String             @db.Uuid
  sourceCurrency                String
  destinationCurrency           String
  amount                        Decimal            @db.Decimal(24, 8)
  targetAmount                  Decimal            @db.Decimal(24, 8)
  rate                          Decimal?           @db.Decimal(24, 12)
  rateSource                    String             @db.VarChar(100)
  description                   String             @db.VarChar(500)
  payloadHash                   String             @db.Char(64)
  state                         String             @default("DRAFT") @db.VarChar(20)
  version                       Int                @default(1)
  createdAt                     DateTime           @default(now()) @db.Timestamptz(3)
  handedOverAt                  DateTime?          @db.Timestamptz(3)
  receivedAt                    DateTime?          @db.Timestamptz(3)
  handedOverById                String?            @db.Uuid
  receivedById                  String?            @db.Uuid
  operationId                   String?            @unique @db.Uuid
  slip                          Json?
  sourceCurrencyDefinition      CurrencyDefinition @relation("TransferOrder_sourceCurrency_catalog", fields: [sourceCurrency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "TransferOrder_sourceCurrency_catalog_fk")
  destinationCurrencyDefinition CurrencyDefinition @relation("TransferOrder_destinationCurrency_catalog", fields: [destinationCurrency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "TransferOrder_destinationCurrency_catalog_fk")

  @@unique([companyId, id])
  @@index([companyId, createdAt, id])
}

model CashClosureReport {
  id             String   @id @db.Uuid
  companyId      String   @db.Uuid
  cashRegisterId String   @db.Uuid
  sessionId      String   @unique @db.Uuid
  closedById     String   @db.Uuid
  closedAt       DateTime @db.Timestamptz(3)
  snapshot       Json

  @@index([companyId, closedAt])
}

model FinancialCategory {
  id        String  @id @db.Uuid
  companyId String  @db.Uuid
  code      String  @db.VarChar(40)
  name      String  @db.VarChar(80)
  kind      String  @db.VarChar(10)
  active    Boolean @default(true)
  version   Int     @default(1)

  @@unique([companyId, code])
}

model ReferenceExchangeRate {
  id                     String             @id @db.Uuid
  companyId              String             @db.Uuid
  fromCurrency           String
  toCurrency             String
  rate                   Decimal            @db.Decimal(24, 12)
  source                 String             @db.VarChar(100)
  validFrom              DateTime           @db.Timestamptz(3)
  publishedAt            DateTime           @default(now()) @db.Timestamptz(3)
  publishedById          String             @db.Uuid
  fromCurrencyDefinition CurrencyDefinition @relation("ReferenceExchangeRate_fromCurrency_catalog", fields: [fromCurrency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "ReferenceExchangeRate_fromCurrency_catalog_fk")
  toCurrencyDefinition   CurrencyDefinition @relation("ReferenceExchangeRate_toCurrency_catalog", fields: [toCurrency], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "ReferenceExchangeRate_toCurrency_catalog_fk")

  @@index([companyId, validFrom])
}

model CurrencyDefinition {
  code                               String                  @id
  numericCode                        String                  @db.VarChar(3)
  name                               String                  @db.VarChar(160)
  symbol                             String                  @db.VarChar(20)
  precision                          Int
  active                             Boolean                 @default(true)
  bccRateStatus                      String                  @default("UNVERIFIED") @db.VarChar(16)
  sourceDate                         String                  @db.VarChar(10)
  referenceExchangeRate_fromCurrency ReferenceExchangeRate[] @relation("ReferenceExchangeRate_fromCurrency_catalog")
  referenceExchangeRate_toCurrency   ReferenceExchangeRate[] @relation("ReferenceExchangeRate_toCurrency_catalog")
  transferOrder_sourceCurrency       TransferOrder[]         @relation("TransferOrder_sourceCurrency_catalog")
  transferOrder_destinationCurrency  TransferOrder[]         @relation("TransferOrder_destinationCurrency_catalog")
  paymentVoucher_currency            PaymentVoucher[]        @relation("PaymentVoucher_currency_catalog")
  expensePolicy_currency             ExpensePolicy[]         @relation("ExpensePolicy_currency_catalog")
  cashReceipt_currency               CashReceipt[]           @relation("CashReceipt_currency_catalog")
  importedDraft_currency             ImportedDraft[]         @relation("ImportedDraft_currency_catalog")
  exchangeRate_fromCurrency          ExchangeRate[]          @relation("ExchangeRate_fromCurrency_catalog")
  exchangeRate_toCurrency            ExchangeRate[]          @relation("ExchangeRate_toCurrency_catalog")
  transfer_currency                  Transfer[]              @relation("Transfer_currency_catalog")
  fundReservation_currency           FundReservation[]       @relation("FundReservation_currency_catalog")
  expenseApproval_currency           ExpenseApproval[]       @relation("ExpenseApproval_currency_catalog")
  expenseRequest_currency            ExpenseRequest[]        @relation("ExpenseRequest_currency_catalog")
  ledgerEntry_currency               LedgerEntry[]           @relation("LedgerEntry_currency_catalog")
  financialOperation_currency        FinancialOperation[]    @relation("FinancialOperation_currency_catalog")
  treasuryAccount_currency           TreasuryAccount[]       @relation("TreasuryAccount_currency_catalog")
  companies                          CompanyCurrency[]
}

model CompanyCurrency {
  companyId           String                    @db.Uuid
  code                String
  active              Boolean                   @default(true)
  version             Int                       @default(1)
  company             Company                   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  definition          CurrencyDefinition        @relation(fields: [code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  reportingSettings   CompanyMonetarySettings[] @relation("CompanyReportingCurrency")
  displayPreferences  UserMoneyPreference[]     @relation("UserDisplayCurrency")
  favoritePreferences UserMoneyPreference[]     @relation("UserFavoriteCurrency")

  @@id([companyId, code])
}

model CompanyMonetarySettings {
  companyId         String           @id @db.Uuid
  reportingCurrency String?
  version           Int              @default(1)
  company           Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reporting         CompanyCurrency? @relation("CompanyReportingCurrency", fields: [companyId, reportingCurrency], references: [companyId, code], onDelete: NoAction, onUpdate: NoAction)
}

model UserMoneyPreference {
  companyId        String           @db.Uuid
  userId           String           @db.Uuid
  displayCurrency  String?
  favoriteCurrency String?
  locale           String           @default("fr-FR") @db.VarChar(10)
  version          Int              @default(1)
  member           CompanyMember    @relation(fields: [companyId, userId], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  display          CompanyCurrency? @relation("UserDisplayCurrency", fields: [companyId, displayCurrency], references: [companyId, code], onDelete: NoAction, onUpdate: NoAction)
  favorite         CompanyCurrency? @relation("UserFavoriteCurrency", fields: [companyId, favoriteCurrency], references: [companyId, code], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, userId])
}
